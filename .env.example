# Leave secrets blank on first install. Each user configures their own keys in Settings.
APIFY_TOKEN=
JOB_TRACKER_SEARCH_MODE=free
JOB_TRACKER_FREE_SOURCE_TIMEOUT=20

# External AI accounts are used directly by the user; no AI credentials are stored here.

# Optional Google OAuth environment configuration. Prefer the owner setup panel in Settings.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Shared Users Online presence (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
